# ملف مثال لمتغيرات البيئة.
# انسخ هذا الملف إلى ".env" ثم عدّل القيم.
# ملاحظة: التطبيق يقرأ متغيرات البيئة هذه تلقائيًا عند التشغيل.

# بيانات اعتماد OAuth 2.0 الخاصة بـ Google Drive
# يمكنك الحصول عليها من Google Cloud Console: APIs & Services > Credentials
GOOGLE_CLIENT_ID=ضع_معرّف_العميل_هنا.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ضع_السر_هنا

# (اختياري) مسار مخصّص لمتصفح Chrome/Chromium الذي يستخدمه Puppeteer
# إن لم يُحدَّد فسيُستخدم Chromium المُرفَق مع puppeteer تلقائيًا.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# (اختياري) معرّف مجلد Google Drive الهدف لرفع التسجيلات إليه.
# اتركه فارغًا للرفع إلى "My Drive" الجذر.
# GDRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
