{
  "name": "meet-audio-recorder-pro",
  "version": "1.1.0",
  "description": "Professional desktop app to join Google Meet, record audio, auto-upload to Google Drive, and export a final Windows EXE installer.",
  "main": "src/main/main.js",
  "author": "fady-shehata0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fady-shehata0/meet-audio-recorder.git"
  },
  "homepage": "https://github.com/fady-shehata0/meet-audio-recorder#readme",
  "bugs": {
    "url": "https://github.com/fady-shehata0/meet-audio-recorder/issues"
  },
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env ELECTRON_ENABLE_LOGGING=1 electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:win:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "puppeteer": "^23.0.0",
    "puppeteer-stream": "^3.0.23"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.fady.meetrecorder.pro",
    "productName": "Meet Recorder Pro",
    "artifactName": "MeetRecorder-Pro-${version}-${platform}-${arch}.${ext}",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "build/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fady-shehata0",
        "repo": "meet-audio-recorder",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png",
      "shortcutName": "Meet Recorder Pro"
    },
    "portable": {
      "artifactName": "MeetRecorder-Pro-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
